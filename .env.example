# Server
PORT=3000
NODE_ENV=development

# Optional: extra comma-separated origins allowed by CORS, in addition to
# https://studycore.academy and https://www.studycore.academy. Only add an
# origin you fully trust - it will be able to read authenticated responses
# from your users' browsers. Leave unset unless you genuinely need one.
# CORS_ALLOWED_ORIGINS=https://another.trusted.example.com

# Auth - REQUIRED. Must be at least 32 characters; the app refuses to start
# without it (never use a short or shared secret - generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=replace-this-with-a-long-random-secret

# Seeded admin account (created automatically on first boot if no admin exists).
# Change the password immediately after first login.
ADMIN_EMAIL=admin@studycore.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Dr. Relentless

# Max upload size in MB for documents/images/audio. Default 200 when unset.
# The value is clamped to a hard cap of 2048 so it can never become
# unbounded. Large lecture videos are expected to move to Cloudflare Stream;
# raise this only if you still upload videos through the R2 document path.
MAX_UPLOAD_MB=200

# Content Admin registration access code - REQUIRED. Server-side only; it is
# never returned, logged, or embedded in any frontend asset. The app refuses
# to start without it. Keep it long and random, and rotate it if it is ever
# shared.
CONTENT_ADMIN_ACCESS_CODE=replace-this-with-a-long-random-secret

# On Render, set this to your persistent disk's mount path (e.g. /var/data)
# so the database survives restarts and redeploys. Leave unset for local
# development - it will just use a folder inside this project instead.
DATA_DIR=

# Cloudflare R2 - where uploaded files (documents, videos, images) actually
# live. Every uploaded file is stored here, not on this server's disk, so
# nothing is lost if the server restarts or redeploys. Get these from your
# Cloudflare dashboard: R2 > Manage R2 API Tokens > Create User API Token.
# R2_ACCOUNT_ID is also visible in the endpoint URL shown on that screen:
# https://<account-id>.r2.cloudflarestorage.com
#
# REQUIRED in production: with NODE_ENV=production the app refuses to start
# if R2 is not fully configured, so production can never silently fall back
# to (ephemeral) local disk. Local development falls back to DATA_DIR/uploads
# when R2 is unset.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=studycore-uploads

# Official WhatsApp links shown in the community panels and footer on every
# page. They have built-in defaults, so only set these if the links change.
WHATSAPP_CHANNEL_URL=https://whatsapp.com/channel/0029Vb6sMBVIiRp0rg5RKQ2k
WHATSAPP_GROUP_URL=https://chat.whatsapp.com/FLRRx5ywcfv76i2Jtjej4i?s=cl&p=a&ilr=4

# Mobile money numbers students see on the Subscribe screen - this is where
# they actually send the money. You confirm it arrived and manually approve
# the request from the admin dashboard; nothing is charged automatically.
# Each number can be registered under a different name.
PAYMENT_PHONE_MTN=0962838485
PAYMENT_NAME_MTN=StudyCore
PAYMENT_PHONE_AIRTEL=0778110879
PAYMENT_NAME_AIRTEL=StudyCore

# Email - used to send students an "access granted" email the moment you
# approve their mobile-money payment. Works with any SMTP provider:
# Gmail app password, Brevo, Mailgun, SendGrid, Resend SMTP, etc.
#   Gmail:      SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true
#               SMTP_USER=you@gmail.com   SMTP_PASS=<16-char app password>
#   Brevo:      SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587
# Leave SMTP unset for local development - approval still works, the email is
# just printed to the server console instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=StudyCore <no-reply@studycore.com>

# Public address of this deployment, used for links inside emails
# (e.g. https://studycore.onrender.com). Falls back to the production site.
APP_URL=
